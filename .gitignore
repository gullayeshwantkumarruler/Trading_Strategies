# Whitelist: this folder also holds unrelated projects; only the trading-strategies work is tracked.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/strategies/
!/research_notes/
!/reports/
!/papers/

# Downloaded third-party PDFs are not redistributed; papers/README.md links to the sources.
/papers/**/*.pdf

# Cached market data (regenerated by the scripts; two files exceed GitHub's 100 MB limit)
/strategies/*/data/

# Python / tooling
__pycache__/
*.pyc
.ipynb_checkpoints/
